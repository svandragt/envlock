# envlock pool for this repo (untracked: see .git/info/exclude).
# shellcheck disable=SC2034,SC2015  # envlock reads ENVS, ENVPOOL_PREFIX and ENVPOOL_MAX, and the create chain ends in || on purpose.
# Change these lines for your project. The rest stays the same for any VIP dev-env site.
# The seed env serves the main checkout and stays out of the pool. New envs copy its versions and database.
ENVPOOL_SEED=site
# envlock creates a name listed here that does not exist yet, on the first acquire with --wait.
ENVS=(site2)
# envlock grows the pool with envpool_create up to ENVPOOL_MAX envs, named ${ENVPOOL_PREFIX}N.
ENVPOOL_PREFIX=site
ENVPOOL_MAX=3
ENVPOOL_TITLE="Example site"
ENVPOOL_MULTISITE=subdirectory
ENVPOOL_MU_PLUGINS=demo
ENVPOOL_MEDIA_DOMAIN=https://www.example.org

# vip is an npm global in the main checkout's devbox; worktree devboxes lack it.
ENVPOOL_MAIN=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
vip() { (cd "$ENVPOOL_MAIN" && devbox run -- vip "$@"); }

# -L: a site that redirects its home page is up once the redirect target answers.
envpool_up() { [ "$(curl -skL -o /dev/null -w '%{http_code}' --max-time 20 "https://$1.vipdev.lndo.site/")" = 200 ]; }

# The proxy answers 404 for the env's hostname until the site is up, so attach waits for 200.
envpool_wait_up() {
	for _ in $(seq 60); do
		envpool_up "$1" && return 0
		sleep 2
	done
	return 1
}

envpool_wp() {
	local env=$1
	shift
	vip dev-env exec --slug="$env" --quiet -- wp "$@"
}

# envlock records a successful switch and skips this while the record names the worktree and envpool_healthy passes.
envpool_attach() {
	if [ -f "$ENVLOCK_WORKTREE/composer.json" ] && [ ! -d "$ENVLOCK_WORKTREE/vendor" ]; then viv install -d "$ENVLOCK_WORKTREE"; fi
	vip dev-env update --slug="$ENVLOCK_ENV" --app-code="$ENVLOCK_WORKTREE"
	vip dev-env start --slug="$ENVLOCK_ENV" --skip-wp-versions-check
	envpool_wait_up "$ENVLOCK_ENV"
}

# Stops a spare env to save memory. The next acquire runs envpool_attach, which starts it again.
envpool_suspend() { vip dev-env stop --slug="$ENVLOCK_ENV"; }

envpool_running() { [ "$(docker inspect -f '{{.State.Running}}' "$ENVLOCK_ENV-php-1" 2>/dev/null)" = true ]; }

envpool_healthy() {
	[ "$(jq -r '.appCode.dir // empty' "$HOME/.local/share/vip/dev-environment/$ENVLOCK_ENV/instance_data.json" 2>/dev/null)" = "$ENVLOCK_WORKTREE" ] && envpool_running && envpool_up "$ENVLOCK_ENV"
}

# A suspended env stays stopped, and a flush that fails on it is harmless, so skip it. multisite is false, true or "subdirectory".
envpool_reset() {
	local flags=()
	envpool_running || return 0
	jq -e .multisite "$HOME/.local/share/vip/dev-environment/$ENVLOCK_ENV/instance_data.json" >/dev/null && flags=(--network)
	envpool_wp "$ENVLOCK_ENV" cache flush "${flags[@]}" || true
}

envpool_exists() { [ -e "$HOME/.local/share/vip/dev-environment/$1" ]; }

# Prints an https URL that logs in to wp-admin on its own, then the wp-cli command. It must be https: over http a headless browser gets an http-only cookie, and its next https admin request bounces to the login page.
envpool_info() {
	jq -er --arg env "$ENVLOCK_ENV" '(.autologinKey // empty) as $k | "https://\($env).vipdev.lndo.site/wp-admin/?vip-dev-autologin=\($k)"' "$HOME/.local/share/vip/dev-environment/$ENVLOCK_ENV/instance_data.json"
	echo "wp-cli: vip dev-env exec --slug=$ENVLOCK_ENV --quiet -- wp <command>"
}

# Prints the attributes envlock matches --need and --want against, for example: wp=7.1 php=8.4
envpool_describe() {
	jq -er '"wp=\(.wordpress.tag) php=\(.php | split(":")[-1])"' "$HOME/.local/share/vip/dev-environment/$ENVLOCK_ENV/instance_data.json"
}

# Changes $ENVLOCK_ENV to the wanted versions, for example: envpool_configure wp=6.9 php=8.3
# Clones copy the seed's database, so an older WordPress version runs on a newer database schema.
# envlock calls this inside an if, where set -e is off, so the steps are chained with &&.
envpool_configure() {
	local flags=() pair
	for pair in "$@"; do
		case $pair in
		wp=*) flags+=(--wordpress="${pair#wp=}") ;;
		php=*) flags+=(--php="${pair#php=}") ;;
		*) echo "envpool_configure: unknown attribute $pair" >&2; return 1 ;;
		esac
	done
	vip dev-env update --slug="$ENVLOCK_ENV" "${flags[@]}" &&
		vip dev-env start --slug="$ENVLOCK_ENV" --skip-wp-versions-check
}

envpool_table_count() {
	docker exec "$1-database-1" mysql -uroot -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='wordpress'"
}

envpool_tables_match() {
	local seed new
	seed=$(envpool_table_count "$ENVPOOL_SEED") && new=$(envpool_table_count "$1") && [ "$seed" -gt 0 ] && [ "$seed" = "$new" ]
}

# --add-drop-database replaces the whole database, so a table that only the env has, such as one a migration added, goes too.
envpool_clone_db() {
	(set -o pipefail; docker exec "$ENVPOOL_SEED-database-1" mysqldump -uroot --single-transaction --quick --routines --databases wordpress --add-drop-database | docker exec -i "$1-database-1" mysql -uroot)
}

# envlock calls this for grown envs only, when no live worktree uses them and another env is free.
envpool_destroy() {
	local d="$HOME/.local/share/vip/dev-environment/$ENVLOCK_ENV"
	# Containers write files as a user-namespace uid the host user cannot delete, so vip destroy stops partway.
	vip dev-env destroy --slug="$ENVLOCK_ENV" || true
	if [ -d "$d" ]; then docker run --rm -v "$d":/x busybox:1.37.0 sh -c 'rm -rf /x/* /x/.[!.]*' && rmdir "$d"; fi
	# Gone means no config dir and no containers, so a repeated destroy also succeeds.
	! envpool_exists "$ENVLOCK_ENV" && [ -z "$(docker ps -aq --filter "name=^$ENVLOCK_ENV-")" ]
}

# Replaces env $1's database with a copy of the seed's. The steps are chained with && because envpool_create calls this inside an if, where set -e is off.
envpool_reseed() {
	envpool_clone_db "$1" &&
		envpool_tables_match "$1" &&
		envpool_wp "$1" search-replace "$ENVPOOL_SEED.vipdev.lndo.site" "$1.vipdev.lndo.site" --network --all-tables --precise --report-changed-only --format=count &&
		envpool_wp "$1" cache flush --network
}

# acquire --fresh runs this on a running env, so the agent starts from the seed's data.
# The clone reads from the seed, so it must be running.
envpool_seed_up() { vip dev-env start --slug="$ENVPOOL_SEED" --skip-wp-versions-check; }

envpool_fresh() { envpool_seed_up && envpool_reseed "$ENVLOCK_ENV"; }

# Clones the seed env into $ENVLOCK_ENV, so the new env never starts with an empty database.
# envlock calls this inside an if, where set -e is off, so every step is chained with && and a failure destroys the half-built env.
envpool_create() {
	local new=$ENVLOCK_ENV data="$HOME/.local/share/vip/dev-environment/$ENVPOOL_SEED/instance_data.json" php wp
	envpool_seed_up && php=$(jq -er '.php | split(":")[-1]' "$data") && wp=$(jq -er .wordpress.tag "$data") &&
		vip dev-env create --slug="$new" --title="$ENVPOOL_TITLE ($new)" --multisite="$ENVPOOL_MULTISITE" --php="$php" --wordpress="$wp" --mu-plugins="$ENVPOOL_MU_PLUGINS" --app-code="$ENVPOOL_MAIN" --media-redirect-domain="$ENVPOOL_MEDIA_DOMAIN" --elasticsearch=n --phpmyadmin=n --xdebug=n --mailpit=n --photon=n --cron=n &&
		vip dev-env start --slug="$new" --skip-wp-versions-check &&
		envpool_reseed "$new" ||
		{ echo "envpool_create: $new failed, destroying it" >&2; vip dev-env destroy --slug="$new" || true; return 1; }
}
