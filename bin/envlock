#!/usr/bin/env bash
# Lease one environment from a repo's pool for as long as an agent session is busy.
# Config: .envpool at the worktree root, sourced as bash. It sets ENVS=(...)
# and may define envpool_reset and envpool_attach; both see ENVLOCK_ENV and
# ENVLOCK_WORKTREE. It may also define envpool_healthy (sees ENVLOCK_ENV),
# which lets envlock skip envpool_attach when the env already serves the
# worktree. To let the pool grow it also sets ENVPOOL_PREFIX and
# ENVPOOL_MAX and defines envpool_create (sees ENVLOCK_ENV, must return
# non-zero on failure) and optionally envpool_exists NAME. To let it shrink
# again it defines envpool_destroy (same contract as envpool_create).
# envpool_describe (sees ENVLOCK_ENV) prints the env's attributes as space-separated
# key=value pairs. With it, acquire --need key=value leases an env that has them and
# acquire --want key=value only prefers an env that has them.
# envpool_configure key=value... (sees ENVLOCK_ENV, same contract as
# envpool_create) changes an env that lacks a needed pair, before reset and attach.
set -euo pipefail

usage() {
	echo "usage: envlock acquire [--wait SECONDS] [--need KEY=VALUE]... [--want KEY=VALUE]..." >&2
	echo "       envlock env" >&2
	echo "       envlock release" >&2
	echo "       envlock status" >&2
	echo "       envlock grow" >&2
	echo "       envlock shrink" >&2
	exit 2
}

# These two functions are the only herdr-specific code.
# Prints the id of the calling agent session; fails with a message when there is none.
session_id() {
	[ -n "${HERDR_PANE_ID:-}" ] || { echo "envlock: HERDR_PANE_ID is not set; run acquire from a herdr pane" >&2; return 1; }
	command -v herdr >/dev/null || { echo "envlock: herdr is not on PATH" >&2; return 1; }
	echo "$HERDR_PANE_ID"
}

# Blocks until session $1 is idle, done or gone. It execs, so call it in a process of its own: that process becomes the waiter, and killing it ends the wait.
session_wait_idle() { exec herdr agent wait "$1" --until idle --until 'done'; }

worktree=$(git rev-parse --show-toplevel)
branch=$(git -C "$worktree" branch --show-current)
# Locks live per repository, not per worktree, so every worktree shares one pool.
common=$(cd "$worktree" && realpath "$(git rev-parse --git-common-dir)")
state="${XDG_STATE_HOME:-$HOME/.local/state}/envlock"
lockdir="$state/$(printf '%s' "$common" | sha1sum | cut -c1-12)"
# Each env's .lock, .holder and .attached files live here, outside the per-repo directory, so repos that list the same env share one lock.
envdir="$state/envs"
queue="$lockdir/queue"
# One record per worktree: its path on line 1 and the env it leased last on line 2.
last="$lockdir/last"
mkdir -p "$queue" "$last" "$envdir"

# Fall back to the main checkout, so an untracked .envpool serves every worktree.
pool="$worktree/.envpool"
[ -f "$pool" ] || pool="$(dirname "$common")/.envpool"
[ -f "$pool" ] || { echo "envlock: no .envpool in $worktree or the main checkout" >&2; exit 1; }
# shellcheck source=/dev/null
source "$pool"
[ "${#ENVS[@]}" -gt 0 ] || { echo "envlock: .envpool sets no ENVS" >&2; exit 1; }

# The pool is ENVS plus the envs that growth has added.
load_envs() {
	mapfile -t all < <({ printf '%s\n' "${ENVS[@]}"; cat "$lockdir/envs" 2>/dev/null || true; } | awk 'NF && !seen[$0]++')
}

# Prints env $1's attributes; prints nothing when envpool_describe is missing or fails.
describe() {
	local out
	if declare -F envpool_describe >/dev/null && out=$(ENVLOCK_ENV=$1 envpool_describe); then printf '%s\n' "$out"; fi
}

# Succeeds when the attribute string $1 contains every pair after it.
has_all() {
	local attrs=$1 pair
	shift
	for pair in "$@"; do [[ " $attrs " == *" $pair "* ]] || return 1; done
}

# Succeeds when env $1 has every --need pair; with no --need every env does.
needs_met() {
	[ "${#need[@]}" -eq 0 ] || has_all "$(describe "$1")" "${need[@]}"
}

# Runs envpool_configure on env $1 for the needed pairs. After a failure the env is in an unknown state, so the attach record goes.
run_configure() {
	echo "envlock: configuring $1 for ${need[*]}" >&2
	if ! ENVLOCK_ENV=$1 ENVLOCK_WORKTREE=$worktree envpool_configure "${need[@]}" >&2; then
		rm -f "$envdir/$1.attached"
		echo "envlock: configuring $1 failed" >&2
		return 1
	fi
}

can_grow() {
	[ -n "${ENVPOOL_MAX:-}" ] && [ "${#all[@]}" -lt "$ENVPOOL_MAX" ] && declare -F envpool_create >/dev/null
}

# Prints the live queue entries oldest first and deletes the dead ones.
# shortcut: kill -0 can match a recycled pid, so a dead waiter's entry may linger; store the process start time if that ever stalls the queue.
queue_entries() {
	local f
	for f in "$queue"/*; do
		[ -e "$f" ] || continue
		if kill -0 "${f##*.}" 2>/dev/null; then echo "$f"; else rm -f "$f"; fi
	done
}

# Returns 0 when an env was added, 1 when envpool_create failed, 2 when nothing was attempted.
# With --capped it also refuses to go past ENVPOOL_MAX.
grow() {
	local n=2 new
	# The block closes fd 8 on exit, so envpool_create's leftovers never hold the grow lock.
	{
		flock -n 8 || { echo "envlock: another grow is running" >&2; return 2; }
		load_envs
		[ "${1:-}" != --capped ] || can_grow || return 2
		{ declare -F envpool_create >/dev/null && [ -n "${ENVPOOL_PREFIX:-}" ]; } ||
			{ echo "envlock: .envpool needs ENVPOOL_PREFIX and envpool_create to grow" >&2; return 2; }
		new=$ENVPOOL_PREFIX$n
		while [[ " ${all[*]} " == *" $new "* ]] || { declare -F envpool_exists >/dev/null && envpool_exists "$new"; }; do
			n=$((n + 1))
			new=$ENVPOOL_PREFIX$n
		done
		echo "envlock: creating $new" >&2
		# Inside an if, set -e is off, so envpool_create has to return non-zero itself.
		if ENVLOCK_ENV=$new envpool_create >&2; then
			echo "$new" >>"$lockdir/envs"
			echo "envlock: added $new" >&2
		else
			echo "envlock: creating $new failed, not added" >&2
			return 1
		fi
	} 8>"$lockdir/grow.lock"
}

# Keeps one env free: when the lease just taken used the last one, grow in the background.
# Returns 0 when it started a grow, 1 when it did not.
headroom() {
	local f
	load_envs
	can_grow || return 1
	for f in "${all[@]}"; do
		if flock -n "$envdir/$f.lock" true 2>/dev/null; then return 1; fi
	done
	echo "envlock: no free env left, growing in the background (log: $lockdir/grow.log)" >&2
	# fd 9 is closed for the child so a long grow never holds the lease.
	setsid "$0" grow --capped 9>&- </dev/null >>"$lockdir/grow.log" 2>&1 &
}

# Succeeds when a worktree that still exists last leased env $1. Deletes the records of worktrees that are gone.
env_in_use() {
	local f wt name used=1
	for f in "$last"/*; do
		[ -e "$f" ] || continue
		{ IFS= read -r wt && IFS= read -r name; } <"$f" || true
		if [ -d "$wt" ]; then [ "$name" != "$1" ] || used=0; else rm -f "$f"; fi
	done
	return "$used"
}

# Succeeds when an env other than $1 is free right now.
other_free() {
	local f
	for f in "${all[@]}"; do
		[ "$f" != "$1" ] || continue
		if flock -n "$envdir/$f.lock" true 2>/dev/null; then return 0; fi
	done
	return 1
}

# Removes envs that growth added once no live worktree uses them, as long as another env stays free.
# Returns 0 when it ran, 2 when it could not start.
shrink() {
	local e grown removed=''
	declare -F envpool_destroy >/dev/null || { echo "envlock: .envpool needs envpool_destroy to shrink" >&2; return 2; }
	# Fd 8 is the pool lock, fd 7 the candidate's lease lock. The blocks close them on exit, so envpool_destroy's leftovers never hold either.
	{
		flock -n 8 || { echo "envlock: a grow or shrink is running" >&2; return 2; }
		mapfile -t grown < <(awk 'NF && !seen[$0]++' "$lockdir/envs" 2>/dev/null)
		for e in "${grown[@]}"; do
			[[ " ${ENVS[*]} " != *" $e "* ]] || continue
			{
				# Holding the lease lock stops anyone leasing $e while it is destroyed. The lock file is never deleted: a lease that races with the removal still locks the same inode, then finds the name gone.
				flock -n 7 || continue
				load_envs
				if env_in_use "$e" || ! other_free "$e"; then continue; fi
				echo "envlock: destroying $e" >&2
				# Inside an if, set -e is off, so envpool_destroy has to return non-zero itself.
				if ENVLOCK_ENV=$e envpool_destroy >&2; then
					awk -v e="$e" '$0 != e' "$lockdir/envs" >"$lockdir/envs.tmp" && mv "$lockdir/envs.tmp" "$lockdir/envs"
					rm -f "$envdir/$e".{holder,attached}
					echo "envlock: removed $e" >&2
					removed=1
				else
					echo "envlock: destroying $e failed, kept" >&2
				fi
			} 7>"$envdir/$e.lock"
		done
	} 8>"$lockdir/grow.lock"
	# A lease may have taken the last free env during the destroy, when its own headroom could not grow.
	[ -z "$removed" ] || headroom || true
}

# Starts a shrink in the background when growth has added envs and envpool_destroy can remove them.
shrink_in_background() {
	if declare -F envpool_destroy >/dev/null && [ -s "$lockdir/envs" ]; then
		setsid "$0" shrink 9>&- </dev/null >>"$lockdir/grow.log" 2>&1 &
	fi
}

# Sets lease_env and lease_pid when this worktree holds a live lease.
find_lease() {
	local holder
	load_envs
	for lease_env in "${all[@]}"; do
		holder=$(cat "$envdir/$lease_env.holder" 2>/dev/null) || continue
		[[ $holder == "$worktree ("* ]] || continue
		lease_pid=${holder##* pid }
		# Holder files outlive their lease, so only trust a pid that still has this env's lock open.
		[ "$(readlink "/proc/$lease_pid/fd/9" 2>/dev/null)" = "$envdir/$lease_env.lock" ] && return 0
	done
	return 1
}

# Prints the pool in the order acquire tries it: envs with the needed attributes before the rest, then envs with the wanted ones, then envs whose holder names this worktree.
# Without envpool_configure an env that lacks a needed pair is left out.
try_order() {
	local e r attrs n w h
	local -A tier
	for e in "${all[@]}"; do
		attrs='' n=0 w=0 h=0
		[ $((${#need[@]} + ${#want[@]})) -eq 0 ] || attrs=$(describe "$e")
		has_all "$attrs" "${need[@]}" || n=4
		has_all "$attrs" "${want[@]}" || w=2
		[[ $(cat "$envdir/$e.holder" 2>/dev/null) == "$worktree ("* ]] || h=1
		tier[$e]=$((n + w + h))
	done
	for r in 0 1 2 3 4 5 6 7; do
		if [ "$r" -ge 4 ] && ! declare -F envpool_configure >/dev/null; then break; fi
		for e in "${all[@]}"; do
			if [ "${tier[$e]}" = "$r" ]; then echo "$e"; fi
		done
	done
}

# Leaves the lease on fd 9 and its env name in $e; exits 75 when none frees up within $1 seconds.
acquire() {
	local deadline=$((SECONDS + $1)) grow_failed='' mismatch='' rc q=() order=()
	qentry="$queue/$(date +%s%N).$$"
	echo "$worktree ($branch) pid $$" >"$qentry"
	trap 'rm -f "$qentry"' EXIT
	while :; do
		mapfile -t q < <(queue_entries)
		if [ "${q[0]:-}" = "$qentry" ]; then
			load_envs
			# An env whose holder file still names this worktree already serves its code, so it ranks first.
			mapfile -t order < <(try_order)
			for e in "${order[@]}"; do
				exec 9>"$envdir/$e.lock"
				if flock -n 9; then
					# A shrink drops a name from the pool while it holds the lock, so a name that is gone is not leasable.
					load_envs
					if [[ " ${all[*]} " == *" $e "* ]]; then
						# The env may have changed since it was ranked, so the needs are checked again under the lock.
						mismatch=''
						needs_met "$e" || mismatch=1
						if [ -z "$mismatch" ] || declare -F envpool_configure >/dev/null; then break 2; fi
					fi
				fi
				exec 9>&-
			done
			# Growing takes minutes, so a fail-fast caller never waits for it.
			if [ "$1" -gt 0 ] && [ -z "$grow_failed" ] && can_grow; then
				rc=0
				grow --capped || rc=$?
				[ "$rc" -ne 1 ] || grow_failed=1
				[ "$rc" -ne 0 ] || continue
			fi
		fi
		[ "$SECONDS" -lt "$deadline" ] || { echo "envlock: all environments busy${need[*]:+ or lacking ${need[*]}}" >&2; exit 75; }
		sleep 5
	done
	rm -f "$qentry"
	export ENVLOCK_ENV=$e ENVLOCK_WORKTREE=$worktree
	# No pid yet, so find_lease ignores this record until the holder runs.
	echo "$worktree ($branch) pane $session" >"$envdir/$e.holder"
	# Written through a dot file and mv, so a shrink never reads half a record.
	printf '%s\n%s\n' "$worktree" "$e" >"$last/.$$" && mv "$last/.$$" "$last/$(printf '%s' "$worktree" | sha1sum | cut -c1-40)"
	echo "envlock: using $e" >&2
	[ -z "$mismatch" ] || run_configure "$e" || exit 1
	# Hook output goes to stderr, so stdout carries only the env name.
	if declare -F envpool_reset >/dev/null; then envpool_reset >&2; fi
	if declare -F envpool_attach >/dev/null; then
		if [ "$(cat "$envdir/$e.attached" 2>/dev/null)" = "$worktree" ] && { ! declare -F envpool_healthy >/dev/null || envpool_healthy >&2; }; then
			echo "envlock: $e already serves $worktree" >&2
		else
			# The record is written only after a switch that succeeded; a failing hook exits under set -e before it.
			rm -f "$envdir/$e.attached"
			envpool_attach >&2
			printf '%s\n' "$worktree" >"$envdir/$e.attached"
		fi
	fi
	# The holder inherits fd 9 and keeps the lease until the session is idle or done, or the wait fails.
	setsid bash -c "$(declare -f session_wait_idle); session_wait_idle \"\$1\"" _ "$session" </dev/null >>"$lockdir/holder.log" 2>&1 &
	echo "$worktree ($branch) pane $session pid $!" >"$envdir/$e.holder"
	exec 9>&-
	echo "$e"
	headroom || shrink_in_background
}

cmd=${1:-}; shift || true
case "$cmd" in
status)
	load_envs
	busy=0
	lines=()
	for e in "${all[@]}"; do
		attrs=$(describe "$e")
		if flock -n "$envdir/$e.lock" true 2>/dev/null; then
			lines+=("$e  free${attrs:+  $attrs}")
		else
			busy=$((busy + 1))
			lines+=("$e  held by $(cat "$envdir/$e.holder" 2>/dev/null || echo unknown)${attrs:+  $attrs}")
		fi
	done
	mapfile -t q < <(queue_entries)
	echo "$busy/${#all[@]} in use, $((${#all[@]} - busy)) free, ${#q[@]} queued, cap ${ENVPOOL_MAX:-none}"
	printf '%s\n' "${lines[@]}"
	for i in "${!q[@]}"; do
		echo "queued $((i + 1))  $(cat "${q[$i]}" 2>/dev/null || true)"
	done
	;;
acquire)
	wait=0
	need=() want=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--wait) wait=$2; shift 2 ;;
		--need | --want)
			[[ ${2:-} == ?*=?* ]] || { echo "envlock: $1 needs key=value" >&2; exit 2; }
			if [ "$1" = --need ]; then need+=("$2"); else want+=("$2"); fi
			shift 2 ;;
		*) usage ;;
		esac
	done
	if ! declare -F envpool_describe >/dev/null; then
		[ "${#need[@]}" -eq 0 ] || { echo "envlock: --need requires envpool_describe in .envpool" >&2; exit 1; }
		[ "${#want[@]}" -eq 0 ] || echo "envlock: ignoring --want, .envpool has no envpool_describe" >&2
		want=()
	fi
	session=$(session_id) || exit 1
	if find_lease; then
		if ! needs_met "$lease_env"; then
			declare -F envpool_configure >/dev/null || { echo "envlock: $lease_env lacks ${need[*]} and .envpool has no envpool_configure; run envlock release first" >&2; exit 1; }
			run_configure "$lease_env" || exit 1
		fi
		echo "$lease_env"; exit 0
	fi
	acquire "$wait"
	;;
env)
	find_lease || exit 1
	echo "$lease_env"
	;;
release)
	find_lease || { echo "envlock: no lease held by $worktree"; exit 0; }
	kill "$lease_pid"
	echo "envlock: released $lease_env (pid $lease_pid)"
	;;
grow)
	grow "${1:-}"
	;;
shrink)
	shrink
	;;
*) usage ;;
esac
