#!/usr/bin/env python3
# Lease one environment from a repo's pool for as long as an agent session is busy.
# Config: .envpool at the worktree root, sourced as bash. It sets ENVS=(...)
# and may define envpool_reset and envpool_attach; both see ENVLOCK_ENV and
# ENVLOCK_WORKTREE. It may also define envpool_healthy (sees ENVLOCK_ENV),
# which lets envlock skip envpool_attach when the env already serves the
# worktree. To let the pool grow it also sets ENVPOOL_PREFIX and
# ENVPOOL_MAX and defines envpool_create (sees ENVLOCK_ENV, must return
# non-zero on failure) and optionally envpool_exists NAME, which also lets acquire create
# ENVS names that do not exist yet. To let it shrink again it defines envpool_destroy
# (same contract as envpool_create).
# envpool_describe (sees ENVLOCK_ENV) prints the env's attributes as space-separated
# key=value pairs. With it, acquire --need key=value leases an env that has them and
# acquire --want key=value only prefers an env that has them.
# envpool_configure key=value... (sees ENVLOCK_ENV, same contract as
# envpool_create) changes an env that lacks a needed pair, before reset and attach.
# envpool_info (sees ENVLOCK_ENV and ENVLOCK_WORKTREE) prints a hint for the caller,
# such as a login URL, after every successful acquire, new lease or reuse.
# envpool_suspend (sees ENVLOCK_ENV, same contract as envpool_destroy) stops a spare env
# to save memory; the next acquire of it runs envpool_attach, which must start it.
# envpool_fresh (sees ENVLOCK_ENV and ENVLOCK_WORKTREE) replaces the env's database with the seed's; acquire --fresh runs it after envpool_attach and on reuse.
# envpool_watch (sees ENVLOCK_ENV, ENVLOCK_WORKTREE and ENVLOCK_SLOT) runs a build watcher in the foreground; acquire --watch starts it, on a new lease or a reuse, and the holder stops it when the lease ends.
# Every hook runs for a leased env with ENVLOCK_SLOT, a small number that stays the same for that env until it is destroyed.
# Every hook runs with envlock's lock fds closed, so nothing a hook starts holds a lock.
import fcntl
import hashlib
import os
import shutil
import signal
import subprocess
import sys
import time
from contextlib import contextmanager
from subprocess import DEVNULL, PIPE, STDOUT

USAGE = """usage: envlock acquire [--wait SECONDS] [--urgent] [--fresh] [--watch] [--need KEY=VALUE]... [--want KEY=VALUE]...
       envlock env
       envlock release
       envlock status
       envlock grow
       envlock shrink
       envlock suspend"""

# close_fds keeps every lock fd away from the child. restore_signals=False hands acquire's ignored SIGPIPE on, as a shell does.
POPEN = {"close_fds": True, "restore_signals": False}


def emit(fd, msg):
    # Writes straight to the fd: a closed pipe then makes the write fail instead of leaving buffered text that fails again at exit.
    try:
        os.write(fd, (msg + "\n").encode("utf-8", "surrogateescape"))
        return True
    except OSError:
        return False


def err(msg):
    emit(2, msg)


def usage(code=2):
    err(USAGE)
    sys.exit(code)


def read(path):
    """The file's text without trailing newlines, as $(cat file); None when it cannot be read."""
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read().rstrip("\n")
    except OSError:
        return None


def write(path, text):
    with open(path, "w", encoding="utf-8", errors="surrogateescape") as f:
        f.write(text)


def rm(path):
    try:
        os.remove(path)
    except OSError:
        pass


def names(text):
    """The non-blank lines of text, each once, in order."""
    return list(dict.fromkeys(line for line in text.split("\n") if line.split()))


def git(*args, cwd=None):
    p = subprocess.run(["git", *args], stdout=PIPE, cwd=cwd, encoding="utf-8", errors="surrogateescape", check=False)
    if p.returncode:
        sys.exit(p.returncode)
    return p.stdout.rstrip("\n")


def lock_fd(fd, path):
    """Opens path on exactly fd. Liveness is read from /proc/<pid>/fd/9, so the lease has to be on 9."""
    opened = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o666)
    if opened != fd:
        os.dup2(opened, fd)
        os.close(opened)


def try_lock(fd):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError:
        return False


@contextmanager
def held(path, fd, block=False):
    """Opens path on fd, takes its flock and yields whether it got it; closes fd afterwards."""
    lock_fd(fd, path)
    try:
        if block:
            fcntl.flock(fd, fcntl.LOCK_EX)
        yield True if block else try_lock(fd)
    finally:
        os.close(fd)


def is_free(path):
    """True when nobody holds the lock on path right now."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CREAT, 0o666)
    except OSError:
        return False
    try:
        return try_lock(fd)
    finally:
        os.close(fd)


# These two functions are the only herdr-specific code.
def session_id():
    """The id of the calling agent session; None, after a message, when there is none."""
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        err("envlock: HERDR_PANE_ID is not set; run acquire from a herdr pane")
    elif not shutil.which("herdr"):
        err("envlock: herdr is not on PATH")
    else:
        return pane
    return None


def session_wait_idle(pane):
    """Starts a child that exits when session pane is idle, done or gone, and fails when it cannot wait. The holder waits for it and ends it by killing the process group."""
    return subprocess.Popen(["herdr", "agent", "wait", pane, "--until", "idle", "--until", "done"], **POPEN)


def log(*words):
    """Appends one line to the events log. A failing write never fails envlock."""
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {' '.join(map(str, words))}\n"
    try:
        with open(f"{lockdir}/events.log", "ab", buffering=0) as f:
            f.write(line.encode("utf-8", "surrogateescape"))
    except OSError:
        pass


def trim_log():
    """Keeps the last 5000 lines of the events log once it passes 1 MiB."""
    # shortcut: a line appended between the read and the replace is lost; take the pool lock if lines ever matter.
    path = f"{lockdir}/events.log"
    try:
        if os.stat(path).st_size <= 1048576:
            return
        with open(path, "rb") as f:
            tail = f.readlines()[-5000:]
        with open(f"{path}.{os.getpid()}", "wb") as f:
            f.writelines(tail)
        os.replace(f"{path}.{os.getpid()}", path)
    except OSError:
        pass


def env_slot(env):
    """Env's slot. An env without one gets the lowest positive number that no env holds, which is written under a short lock because envs of every repo share the numbers."""
    path = f"{envdir}/{env}.slot"
    with held(f"{envdir}/slots.lock", 6, block=True):
        if not read(path):
            used = {line for f in os.listdir(envdir) if f.endswith(".slot") and not f.startswith(".") for line in (read(f"{envdir}/{f}") or "").split("\n")}
            n = 1
            while str(n) in used:
                n += 1
            write(path, f"{n}\n")
    return read(path)


def proc_field(pid, n):
    """Field n of /proc/pid/stat (5 is the process group, 22 the start time); empty when the process is gone. The comm field can hold spaces, so the fields are counted after its closing parenthesis."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(") ", 1)[1].split()[n - 3]
    except (OSError, IndexError):
        return ""


def watch_pid(env):
    """The pid that env's pid file records, only while a process with that pid and the recorded start time exists. A recycled pid has another start time, so it never passes."""
    parts = (read(f"{lockdir}/watch/{env}.pid") or "").split("\n")[0].split(None, 1)
    if len(parts) == 2 and parts[0].isdigit() and proc_field(parts[0], 22) == parts[1].strip():
        return parts[0]
    return None


def stop_watch(env, pane, note=None):
    """Ends the watcher that env's pid file records, for pane, and waits up to 5 seconds for it to go, so the port it held is free before the lease is. note goes on the log line. Deletes the file afterwards. A watcher that has already exited leaves nothing to log, and a pid that is not the recorded process is never signalled."""
    pid = watch_pid(env)
    if pid:
        try:
            os.killpg(int(pid), signal.SIGTERM)
        except OSError:
            pass
        for _ in range(50):
            try:
                os.killpg(int(pid), 0)
            except OSError:
                break
            time.sleep(0.1)
        log("watch-stopped", env, label, "pane", pane, "pid", pid, *([note] if note else []))
    rm(f"{lockdir}/watch/{env}.pid")


def hold(env, pane, ready):
    """The holder: runs the wait as a child without fd 9, so only the holder keeps the lease. A TERM from `envlock release` kills the whole process group, wait included, and logs nothing, because release logs it. Whichever way the lease ends, the env's watcher, which is a process group of its own, stops first."""
    why = "idle or done"

    def on_term(*_):
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        stop_watch(env, pane)
        os.killpg(0, signal.SIGTERM)

    signal.signal(signal.SIGTERM, on_term)
    # acquire starts the holder with TERM blocked, so a release that comes at once waits for the handler.
    signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGTERM})
    child = session_wait_idle(pane)
    # acquire waits for this close, so it returns only once the holder runs its wait.
    os.close(int(ready))
    rc = child.wait()
    if rc:
        why = f"wait failed, exit={rc if rc > 0 else 128 - rc}"
    stop_watch(env, pane)
    log("released", env, label, "pane", pane, f"({why})")


def detach(args, log_path, pass_fds=()):
    """Runs envlock args in a session of its own, with no stdin and the output appended to log_path."""
    with open(log_path, "ab") as out:
        return subprocess.Popen([sys.executable, sys.argv[0], *args], stdin=DEVNULL, stdout=out, stderr=STDOUT, start_new_session=True, pass_fds=pass_fds, **POPEN)


def start_watch(env):
    """Starts env's watcher as a process group of its own and records its pid, which is the group id, and its start time for the holder to stop. A fresh shell sources the pool again, so the hook finds its helpers. A watcher that cannot start or dies early only leaves its reason in its log; it never fails the acquire."""
    os.makedirs(f"{lockdir}/watch", exist_ok=True)
    with open(f"{lockdir}/watch/{env}.log", "wb") as out:
        p = subprocess.Popen(
            ["bash", "-c", 'source "$0" && cd "$1" && envpool_watch', pool, worktree],
            env={**os.environ, "ENVLOCK_ENV": env, "ENVLOCK_WORKTREE": worktree},
            stdin=DEVNULL, stdout=out, stderr=STDOUT, start_new_session=True, **POPEN,
        )
    write(f"{lockdir}/watch/{env}.pid", f"{p.pid} {proc_field(p.pid, 22)}\n")
    log("watch", env, label, "pane", session, "pid", p.pid)


# Sources the pool and lists what it defines, NUL-separated, so Python knows which hooks exist.
# The pool's own stdout goes to stderr, so it cannot end up in the list.
LOADER = r"""set -euo pipefail
source "$1" >&2
for f in $(compgen -A function envpool_); do printf 'f:%s\0' "$f"; done
for e in ${ENVS[@]+"${ENVS[@]}"}; do printf 'e:%s\0' "$e"; done
printf 'm:%s\0p:%s\0' "${ENVPOOL_MAX:-}" "${ENVPOOL_PREFIX:-}"
"""


def load_pool():
    global FUNCS, ENVS, MAX_RAW, MAX_N, PREFIX
    p = subprocess.run(["bash", "-c", LOADER, "_", pool], stdout=PIPE, check=False, **POPEN)
    if p.returncode:
        sys.exit(p.returncode)
    fields = p.stdout.decode("utf-8", "surrogateescape").split("\0")[:-1]
    FUNCS = {f[2:] for f in fields if f.startswith("f:")}
    ENVS = [f[2:] for f in fields if f.startswith("e:")]
    MAX_RAW = next(f[2:] for f in fields if f.startswith("m:"))
    PREFIX = next(f[2:] for f in fields if f.startswith("p:"))
    try:
        MAX_N = int(MAX_RAW)
    except ValueError:
        MAX_N = 0


# A plain call keeps errexit on inside the hook, so a failing step ends it; a call that a shell makes inside an if or || leaves it off, so the hook has to return non-zero itself.
RUNNER = 'set -%spipefail; source "$1" >&2; shift; "$@"'


def run_hook(name, *args, plain=False, out=None, **env):
    """Runs hook name in a fresh bash that sources the pool. out is where its stdout goes: None keeps envlock's, 2 is stderr, PIPE captures it."""
    p = subprocess.run(
        ["bash", "-c", RUNNER % ("euo " if plain else "uo "), "_", pool, name, *args],
        stdout=out, env={**os.environ, **env}, encoding="utf-8", errors="surrogateescape", check=False, **POPEN,
    )
    if p.returncode < 0:
        p.returncode = 128 - p.returncode
    return p


def hook(name, *args, **kw):
    return run_hook(name, *args, **kw).returncode


def load_envs():
    """The pool is ENVS plus the envs that growth has added."""
    global ALL
    ALL = names("\n".join(ENVS) + "\n" + (read(f"{lockdir}/envs") or ""))


def describe(env):
    """Env's attributes; empty when envpool_describe is missing or fails."""
    if "envpool_describe" not in FUNCS:
        return ""
    p = run_hook("envpool_describe", out=PIPE, ENVLOCK_ENV=env)
    return p.stdout.rstrip("\n") if p.returncode == 0 else ""


def has_all(attrs, pairs):
    return all(f" {pair} " in f" {attrs} " for pair in pairs)


def needs_met(env):
    """True when env has every --need pair; with no --need every env does."""
    return not need or has_all(describe(env), need)


def run_configure(env):
    """Runs envpool_configure on env for the needed pairs. After a failure the env is in an unknown state, so the attach record goes."""
    err(f"envlock: configuring {env} for {' '.join(need)}")
    rc = hook("envpool_configure", *need, out=2, ENVLOCK_ENV=env, ENVLOCK_WORKTREE=worktree)
    if rc:
        log("configure-failed", env, label, "pane", session, f"exit={rc}")
        rm(f"{envdir}/{env}.attached")
        err(f"envlock: configuring {env} failed")
        return False
    return True


def show_info(env):
    """Runs the optional envpool_info hook. Its output is a hint for the caller, so a failure never fails the acquire."""
    if "envpool_info" in FUNCS:
        hook("envpool_info", out=2, ENVLOCK_ENV=env, ENVLOCK_WORKTREE=worktree)


def can_grow():
    return MAX_RAW != "" and len(ALL) < MAX_N and "envpool_create" in FUNCS


def can_suspend():
    return "envpool_suspend" in FUNCS


def queue_entries():
    """The live queue entries oldest first; deletes the dead ones."""
    # shortcut: kill -0 can match a recycled pid, so a dead waiter's entry may linger; store the process start time if that ever stalls the queue.
    live = []
    for f in sorted(os.listdir(queue_dir)):
        if f.startswith("."):
            continue
        try:
            os.kill(int(f.rsplit(".", 1)[1]), 0)
            live.append(f"{queue_dir}/{f}")
        except (OSError, ValueError, IndexError):
            rm(f"{queue_dir}/{f}")
    return live


def is_missing(env):
    """True when env is an ENVS name that envpool_exists reports missing; envlock creates such a name only when the pool has both hooks."""
    return env in ENVS and "envpool_exists" in FUNCS and "envpool_create" in FUNCS and hook("envpool_exists", env) != 0


def create_missing(env, wait, create_failed):
    """True when env exists. A missing ENVS name is created first. That takes minutes, so a caller without --wait never does it.
    The caller holds the env's lease lock, so nobody else creates or leases it meanwhile; the pool lock keeps a grow or shrink out. After a failed create the env stays unusable for the rest of this acquire."""
    if not is_missing(env):
        return True
    if wait <= 0 or env in create_failed:
        return False
    with held(f"{lockdir}/grow.lock", 8) as got:
        if not got:
            return False
        err(f"envlock: creating {env}")
        rc = hook("envpool_create", out=2, ENVLOCK_ENV=env)
        if rc == 0:
            log("created", env)
            return True
        log("create-failed", env, f"exit={rc}")
        create_failed.add(env)
        err(f"envlock: creating {env} failed")
        return False


def grow(arg):
    """Returns 0 when an env was added, 1 when envpool_create failed, 2 when nothing was attempted.
    With --capped it also refuses to go past ENVPOOL_MAX."""
    with held(f"{lockdir}/grow.lock", 8) as got:
        if not got:
            err("envlock: another grow is running")
            return 2
        load_envs()
        if arg == "--capped" and not can_grow():
            return 2
        if "envpool_create" not in FUNCS or not PREFIX:
            err("envlock: .envpool needs ENVPOOL_PREFIX and envpool_create to grow")
            return 2
        n = 2
        while f"{PREFIX}{n}" in ALL or ("envpool_exists" in FUNCS and hook("envpool_exists", f"{PREFIX}{n}") == 0):
            n += 1
        new = f"{PREFIX}{n}"
        err(f"envlock: creating {new}")
        rc = hook("envpool_create", out=2, ENVLOCK_ENV=new)
        if rc:
            log("grow-failed", new, f"exit={rc}")
            err(f"envlock: creating {new} failed, not added")
            return 1
        with open(f"{lockdir}/envs", "a") as f:
            f.write(f"{new}\n")
        log("grown", new)
        err(f"envlock: added {new}")
        return 0


def headroom():
    """Keeps one env free: when the lease just taken used the last one, grow in the background. True when it started a grow."""
    load_envs()
    if not can_grow() or any(is_free(f"{envdir}/{f}.lock") for f in ALL):
        return False
    err(f"envlock: no free env left, growing in the background (log: {lockdir}/grow.log)")
    detach(["grow", "--capped"], f"{lockdir}/grow.log")
    return True


def env_in_use(env):
    """True when a worktree that still exists last leased env. Deletes the records of worktrees that are gone."""
    used = False
    for f in sorted(os.listdir(last_dir)):
        if f.startswith("."):
            continue
        wt, _, name = (read(f"{last_dir}/{f}") or "").partition("\n")
        if os.path.isdir(wt):
            used = used or name.split("\n")[0] == env
        else:
            rm(f"{last_dir}/{f}")
    return used


def other_free(env):
    """True when an env other than env is free right now."""
    return any(f != env and is_free(f"{envdir}/{f}.lock") for f in ALL)


def shrink():
    """Removes envs that growth added once no live worktree uses them, as long as another env stays free.
    Returns 0 when it ran, 2 when it could not start."""
    if "envpool_destroy" not in FUNCS:
        err("envlock: .envpool needs envpool_destroy to shrink")
        return 2
    removed = False
    # Fd 8 is the pool lock, fd 7 the candidate's lease lock.
    with held(f"{lockdir}/grow.lock", 8) as got:
        if not got:
            err("envlock: a grow or shrink is running")
            return 2
        for e in names(read(f"{lockdir}/envs") or ""):
            if e in ENVS:
                continue
            # Holding the lease lock stops anyone leasing e while it is destroyed. The lock file is never deleted: a lease that races with the removal still locks the same inode, then finds the name gone.
            with held(f"{envdir}/{e}.lock", 7) as mine:
                if not mine:
                    continue
                load_envs()
                if env_in_use(e) or not other_free(e):
                    continue
                err(f"envlock: destroying {e}")
                rc = hook("envpool_destroy", out=2, ENVLOCK_ENV=e)
                if rc == 0:
                    keep = [x for x in (read(f"{lockdir}/envs") or "").split("\n") if x and x != e]
                    write(f"{lockdir}/envs.tmp", "".join(f"{x}\n" for x in keep))
                    os.replace(f"{lockdir}/envs.tmp", f"{lockdir}/envs")
                    for ext in ("holder", "attached", "suspended", "slot"):
                        rm(f"{envdir}/{e}.{ext}")
                    log("shrunk", e)
                    err(f"envlock: removed {e}")
                    removed = True
                else:
                    log("destroy-failed", e, f"exit={rc}")
                    err(f"envlock: destroying {e} failed, kept")
    # A lease may have taken the last free env during the destroy, when its own headroom could not grow.
    if removed:
        headroom()
    return 0


def suspend():
    """Stops the spare envs: pool envs that no live worktree last leased and nobody holds. The marker makes the next acquire run envpool_attach, which starts the env again.
    Returns 0 when it ran, 2 when it could not start."""
    if not can_suspend():
        err("envlock: .envpool needs envpool_suspend to suspend")
        return 2
    # Fd 8 is the pool lock, fd 7 the candidate's lease lock.
    with held(f"{lockdir}/grow.lock", 8) as got:
        if not got:
            err("envlock: a grow or shrink is running")
            return 2
        load_envs()
        for e in ALL:
            if os.path.exists(f"{envdir}/{e}.suspended") or is_missing(e):
                continue
            # Holding the lease lock stops anyone leasing e while it is stopped.
            with held(f"{envdir}/{e}.lock", 7) as mine:
                if not mine or env_in_use(e):
                    continue
                err(f"envlock: suspending {e}")
                # Deleted first, so a half-stopped env still gets envpool_attach on its next lease.
                rm(f"{envdir}/{e}.attached")
                rc = hook("envpool_suspend", out=2, ENVLOCK_ENV=e)
                if rc == 0:
                    write(f"{envdir}/{e}.suspended", "")
                    log("suspended", e)
                    err(f"envlock: suspended {e}")
                else:
                    log("suspend-failed", e, f"exit={rc}")
                    err(f"envlock: suspending {e} failed")
    return 0


def shrink_in_background():
    """Starts a shrink, when growth has added envs and envpool_destroy can remove them, and then a suspend pass, when envpool_suspend exists, in one background job."""
    steps = []
    if "envpool_destroy" in FUNCS and os.path.exists(f"{lockdir}/envs") and os.path.getsize(f"{lockdir}/envs") > 0:
        steps.append("shrink")
    if can_suspend():
        steps.append("suspend")
    if steps:
        detach(["__background", *steps], f"{lockdir}/grow.log")


def find_lease():
    """(env, pid, pane) when this worktree holds a live lease, else None."""
    load_envs()
    for env in ALL:
        holder = read(f"{envdir}/{env}.holder")
        if holder is None or not holder.startswith(f"{worktree} ("):
            continue
        pid = holder.rsplit(" pid ", 1)[-1]
        pane = holder.rsplit(" pane ", 1)[-1].split(" ")[0]
        # Holder files outlive their lease, so only trust a pid that still has this env's lock open.
        if readlink9(pid) == f"{envdir}/{env}.lock":
            return env, pid, pane
    return None


def readlink9(pid):
    try:
        return os.readlink(f"/proc/{pid}/fd/9")
    except OSError:
        return None


def release_pane_lease():
    """Ends the lease that this pane holds for another worktree, because a pane holds one lease at a time. Needs load_envs first."""
    for e in ALL:
        holder = read(f"{envdir}/{e}.holder")
        if holder is None or f" pane {session} pid " not in holder:
            continue
        pid = holder.rsplit(" pid ", 1)[-1]
        if readlink9(pid) != f"{envdir}/{e}.lock":
            continue
        wt = holder.partition(" (")[0]
        name = holder[len(wt) + 2:].partition(") pane ")[0] if holder.startswith(f"{wt} (") else holder
        try:
            os.kill(int(pid), signal.SIGTERM)
        except (OSError, ValueError):
            continue
        log("released", e, name or os.path.basename(wt), "pane", session, f"(moved to {label})")
        # The holder ends asynchronously; the acquire that follows should find this env free.
        for _ in range(50):
            if is_free(f"{envdir}/{e}.lock"):
                break
            time.sleep(0.1)


def try_order():
    """The pool in the order acquire tries it: envs with the needed attributes before the rest, then envs with the wanted ones, then envs whose holder names this worktree. Envs that still have to be created come after all the others, because creating takes minutes.
    Without envpool_configure an env that lacks a needed pair is left out."""
    tier = {}
    for e in ALL:
        attrs = ""
        m = 8 if is_missing(e) else 0
        if (need or want) and not m:
            attrs = describe(e)
        n = 0 if has_all(attrs, need) else 4
        w = 0 if has_all(attrs, want) else 2
        h = 0 if (read(f"{envdir}/{e}.holder") or "").startswith(f"{worktree} (") else 1
        tier[e] = n + w + h + m
    order = []
    for r in range(16):
        if r % 8 >= 4 and "envpool_configure" not in FUNCS:
            continue
        order += [e for e in ALL if tier[e] == r]
    return order


def run_plain(stage, hook_name, env):
    """Runs a hook that has to succeed. The hook's status ends envlock, and the failure is logged under the stage's name."""
    rc = hook(hook_name, plain=True, out=2)
    if rc:
        log(f"{stage}-failed", env, label, "pane", session, f"exit={rc}")
        sys.exit(rc)


def acquire(wait):
    """Leaves the lease on fd 9 and its env name in e; exits 75 when none frees up within wait seconds, and 1 when none exists and creating one failed."""
    deadline = time.monotonic() + wait
    grow_failed = mismatch = False
    create_failed = set()
    asks = [f"need={p}" for p in need] + [f"want={p}" for p in want] + [k for k, v in (("urgent", urgent), ("fresh", fresh), ("watch", watch)) if v]
    # A leading 0 sorts an urgent entry before every timestamp, and urgent entries keep their timestamp order among themselves.
    qentry = f"{queue_dir}/{'0' if urgent else ''}{time.time_ns()}.{os.getpid()}"
    write(qentry, f"{worktree} ({branch}) pid {os.getpid()}\n")
    try:
        log("queued", label, "pane", session, *asks)
        e = None
        while True:
            q = queue_entries()
            if q and q[0] == qentry:
                load_envs()
                # An env whose holder file still names this worktree already serves its code, so it ranks first.
                for cand in try_order():
                    # Test seam: lets a test change the pool just before the lock is taken, as a shrink that finishes first would. Real pools do not need it.
                    if "envpool_before_lock" in FUNCS:
                        hook("envpool_before_lock", out=2, ENVLOCK_ENV=cand)
                    lock_fd(9, f"{envdir}/{cand}.lock")
                    if try_lock(9):
                        # A shrink drops a name from the pool while it holds the lock, so a name that is gone is not leasable.
                        load_envs()
                        if cand in ALL and create_missing(cand, wait, create_failed):
                            # The env may have changed since it was ranked, so the needs are checked again under the lock.
                            mismatch = not needs_met(cand)
                            if not mismatch or "envpool_configure" in FUNCS:
                                e = cand
                                break
                    os.close(9)
                if e:
                    break
                # Growing takes minutes, so a fail-fast caller never waits for it.
                if wait > 0 and not grow_failed and can_grow():
                    rc = grow("--capped")
                    grow_failed = grow_failed or rc == 1
                    if rc == 0:
                        continue
                # Every env is missing, each create failed and no grow can follow, so no lease will ever free up.
                if all(x in create_failed and is_missing(x) for x in ALL) and (grow_failed or not can_grow()):
                    err(f"envlock: no environment exists and creating one failed, nothing to wait for (see {lockdir}/events.log)")
                    sys.exit(1)
            if time.monotonic() >= deadline:
                err(f"envlock: all environments busy{' or lacking ' + ' '.join(need) if need else ''}")
                log("timeout", label, "pane", session, *asks)
                sys.exit(75)
            # ENVLOCK_POLL is a test seam: it lets the tests poll faster than every 5 seconds.
            time.sleep(float(os.environ.get("ENVLOCK_POLL") or 5))
        rm(qentry)
        slot = env_slot(e)
        os.environ.update(ENVLOCK_ENV=e, ENVLOCK_WORKTREE=worktree, ENVLOCK_SLOT=slot)
        # No pid yet, so find_lease ignores this record until the holder runs.
        write(f"{envdir}/{e}.holder", f"{worktree} ({branch}) pane {session}\n")
        # The env is leased now. Configure and reset run before envpool_attach starts it, so they may see it stopped.
        rm(f"{envdir}/{e}.suspended")
        # The lock proves no holder owns a watcher, so one that the pid file still records outlived its holder, which died without TERM.
        stop_watch(e, session, "(stale)")
        # Written through a dot file and a rename, so a shrink never reads half a record.
        write(f"{last_dir}/.{os.getpid()}", f"{worktree}\n{e}\n")
        os.replace(f"{last_dir}/.{os.getpid()}", f"{last_dir}/{hashlib.sha1(os.fsencode(worktree)).hexdigest()}")
        # Not "using" yet: a caller that stops reading at this line must not take the env for leased.
        err(f"envlock: preparing {e}")
        if mismatch and not run_configure(e):
            sys.exit(1)
        # Hook output goes to stderr, so stdout carries only the env name. The hooks below run as plain commands, so errexit applies inside them; a failing one ends envlock with its status, which is logged under its stage.
        if "envpool_reset" in FUNCS:
            run_plain("reset", "envpool_reset", e)
        if "envpool_attach" in FUNCS:
            if read(f"{envdir}/{e}.attached") == worktree and ("envpool_healthy" not in FUNCS or hook("envpool_healthy", out=2) == 0):
                err(f"envlock: {e} already serves {worktree}")
            else:
                # The record is written only after a switch that succeeded; a failing hook exits before it.
                rm(f"{envdir}/{e}.attached")
                run_plain("attach", "envpool_attach", e)
                write(f"{envdir}/{e}.attached", f"{worktree}\n")
        if fresh:
            run_plain("fresh", "envpool_fresh", e)
            log("fresh", e, label, "pane", session)
        # The pid file is written before the holder starts, because the holder reads it when the lease ends.
        if watch:
            start_watch(e)
        # The holder inherits fd 9 and keeps the lease until the wait that it runs as a child returns.
        ready, ready_w = os.pipe()
        signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM})
        try:
            holder = detach(["__hold", e, session, lockdir, label, str(ready_w)], f"{lockdir}/holder.log", pass_fds=(9, ready_w))
        finally:
            signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGTERM})
            os.close(ready_w)
        os.read(ready, 1)
        os.close(ready)
        write(f"{envdir}/{e}.holder", f"{worktree} ({branch}) pane {session} pid {holder.pid}\n")
        log("leased", e, label, "pane", session, "pid", holder.pid)
        os.close(9)
        err(f"envlock: using {e}")
        emit(1, e) or sys.exit(1)
        show_info(e)
        trim_log()
        # The background grow, shrink and suspend run hooks for other envs, which must not see this env's slot.
        del os.environ["ENVLOCK_SLOT"]
        headroom() or shrink_in_background()
    finally:
        rm(qentry)


def cmd_acquire(args):
    global urgent, fresh, watch, session
    wait = 0
    it = iter(args)
    for a in it:
        if a == "--urgent":
            urgent = True
        elif a == "--fresh":
            fresh = True
        elif a == "--watch":
            watch = True
        elif a == "--wait":
            try:
                wait = int(next(it, ""))
            except ValueError:
                usage()
        elif a in ("--need", "--want"):
            v = next(it, "")
            if "=" not in v[1:-1]:
                err(f"envlock: {a} needs key=value")
                sys.exit(2)
            (need if a == "--need" else want).append(v)
        else:
            usage()
    if "envpool_describe" not in FUNCS:
        if need:
            err("envlock: --need requires envpool_describe in .envpool")
            sys.exit(1)
        if want:
            err("envlock: ignoring --want, .envpool has no envpool_describe")
        want.clear()
    if fresh and "envpool_fresh" not in FUNCS:
        err("envlock: --fresh requires envpool_fresh in .envpool")
        sys.exit(1)
    if watch and "envpool_watch" not in FUNCS:
        err("envlock: --watch requires envpool_watch in .envpool")
        sys.exit(1)
    session = session_id()
    if not session:
        sys.exit(1)
    lease = find_lease()
    if lease:
        lease_env = lease[0]
        os.environ["ENVLOCK_SLOT"] = env_slot(lease_env)
        if not needs_met(lease_env):
            if "envpool_configure" not in FUNCS:
                err(f"envlock: {lease_env} lacks {' '.join(need)} and .envpool has no envpool_configure; run envlock release first")
                sys.exit(1)
            if not run_configure(lease_env):
                sys.exit(1)
        if fresh:
            rc = hook("envpool_fresh", out=2, ENVLOCK_ENV=lease_env, ENVLOCK_WORKTREE=worktree)
            if rc:
                log("fresh-failed", lease_env, label, "pane", session, f"exit={rc}")
                err(f"envlock: refreshing {lease_env} failed; the lease is unchanged")
                sys.exit(rc)
            log("fresh", lease_env, label, "pane", session)
        # A watcher that is still running stays; one that is not gets replaced.
        if watch and not watch_pid(lease_env):
            start_watch(lease_env)
        log("reused", lease_env, label, "pane", session)
        emit(1, lease_env) or sys.exit(1)
        show_info(lease_env)
        sys.exit(0)
    release_pane_lease()
    acquire(wait)


def cmd_status():
    load_envs()
    busy = absent = 0
    lines = []
    for e in ALL:
        if is_missing(e):
            absent += 1
            lines.append(f"{e}  not created")
            continue
        attrs = describe(e)
        attrs = f"  {attrs}" if attrs else ""
        if is_free(f"{envdir}/{e}.lock"):
            susp = ", suspended" if os.path.exists(f"{envdir}/{e}.suspended") else ""
            lines.append(f"{e}  free{susp}{attrs}")
        else:
            busy += 1
            holder = read(f"{envdir}/{e}.holder")
            lines.append(f"{e}  held by {'unknown' if holder is None else holder}{attrs}")
    q = queue_entries()
    emit(1, f"{busy}/{len(ALL)} in use, {len(ALL) - busy - absent} free, {len(q)} queued, cap {MAX_RAW or 'none'}")
    for line in lines:
        emit(1, line)
    for i, f in enumerate(q):
        emit(1, f"queued {i + 1}  {read(f) or ''}")
    emit(1, f"events log: {lockdir}/events.log")


def setup():
    global worktree, branch, label, lockdir, envdir, queue_dir, last_dir, pool
    worktree = git("rev-parse", "--show-toplevel")
    branch = git("-C", worktree, "branch", "--show-current")
    # Names the worktree in the events log; a detached HEAD has no branch.
    label = branch or os.path.basename(worktree)
    # Locks live per repository, not per worktree, so every worktree shares one pool.
    common = os.path.realpath(os.path.join(worktree, git("rev-parse", "--git-common-dir", cwd=worktree)))
    state = f"{os.environ.get('XDG_STATE_HOME') or os.path.expanduser('~/.local/state')}/envlock"
    lockdir = f"{state}/{hashlib.sha1(os.fsencode(common)).hexdigest()[:12]}"
    # Each env's .lock, .holder, .attached and .suspended files live here, outside the per-repo directory, so repos that list the same env share one lock.
    envdir = f"{state}/envs"
    queue_dir = f"{lockdir}/queue"
    # One record per worktree: its path on line 1 and the env it leased last on line 2.
    last_dir = f"{lockdir}/last"
    for d in (queue_dir, last_dir, envdir):
        os.makedirs(d, exist_ok=True)
    # Fall back to the main checkout, so an untracked .envpool serves every worktree.
    pool = f"{worktree}/.envpool"
    if not os.path.isfile(pool):
        pool = f"{os.path.dirname(common)}/.envpool"
    if not os.path.isfile(pool):
        err(f"envlock: no .envpool in {worktree} or the main checkout; ask your agent to set up a pool (see README)")
        sys.exit(1)
    load_pool()
    # An empty ENVS is fine when the pool can grow from zero.
    if not ENVS and not (MAX_N > 0 and PREFIX and "envpool_create" in FUNCS):
        err("envlock: .envpool sets no ENVS")
        sys.exit(1)


need, want = [], []
urgent = fresh = watch = False


def main():
    global lockdir, label
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    # Checked before any repo or pool lookup, so help works anywhere.
    if cmd in ("-h", "--help", "help"):
        usage(0)
    if cmd not in ("acquire", "env", "release", "status", "grow", "shrink", "suspend", "__hold", "__background"):
        usage()
    # A caller that closes the pipe (`| head -1`) then makes writes fail instead of killing envlock mid-attach with SIGPIPE.
    signal.signal(signal.SIGPIPE, signal.SIG_IGN if cmd == "acquire" else signal.SIG_DFL)
    args = sys.argv[2:]
    if cmd == "__hold":
        lockdir, label = args[2:4]
        return hold(args[0], args[1], args[4])
    if cmd == "__background":
        for step in args:
            subprocess.run([sys.executable, sys.argv[0], step], check=False, **POPEN)
        return None
    setup()
    if cmd == "status":
        cmd_status()
    elif cmd == "acquire":
        cmd_acquire(args)
    elif cmd == "env":
        lease = find_lease()
        if not lease:
            return 1
        emit(1, lease[0])
    elif cmd == "release":
        lease = find_lease()
        if not lease:
            emit(1, f"envlock: no lease held by {worktree}")
            return 0
        env, pid, pane = lease
        try:
            os.kill(int(pid), signal.SIGTERM)
        except OSError as ex:
            err(f"envlock: kill {pid}: {ex.strerror}")
            return 1
        log("released", env, label, "pane", pane, "(release)")
        emit(1, f"envlock: released {env} (pid {pid})")
    elif cmd == "grow":
        # A grow that acquire runs itself does not suspend: the waiter takes the new env at once.
        rc = grow(args[0] if args else "")
        return suspend() if rc == 0 and can_suspend() else rc
    elif cmd == "shrink":
        return shrink()
    else:
        return suspend()
    return 0


if __name__ == "__main__":
    sys.exit(main())
